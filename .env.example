# Copy to .env (or set these in Vercel → Project → Settings → Environment Variables).

# Contact / demo form emails (app/api/contact/route.js), sent through Resend.
# RESEND_FROM_EMAIL must use a domain verified in Resend, e.g. "Swalook Website <info@swalook.in>".
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Backend API used for extra blog posts published through the CMS (optional — the site's own posts work without it).
NEXT_PUBLIC_API_URL=

# Shared secret the backend sends when it asks the site to revalidate blog pages (app/api/revalidate/route.js).
REVALIDATION_WEBHOOK_SECRET=
